# --- Local dev: docker compose up postgres minio-init -d ---
DATABASE_URL=postgresql://antares:antares@localhost:5433/antares

STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=files

HF_TOKEN=hf_

HF_JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Supabase (production) — set STORAGE_BACKEND=supabase and fill these ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Optional ---
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MAX_UPLOAD_BYTES=104857600
